FROM emscripten/emsdk:3.1.56@sha256:f9479effb0d095fea1c8501b57c18d13876a5e3bfebcb71f0da68a0fe49c935f AS build

RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake ninja-build python3-venv libegl1 libgl1 libxkbcommon0 libfontconfig1 libdbus-1-3 \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/aqt && /opt/aqt/bin/pip install --no-cache-dir aqtinstall==3.3.0
RUN /opt/aqt/bin/aqt install-qt linux desktop 6.8.3 linux_gcc_64 -O /opt/qt --archives qtbase icu \
    && /opt/aqt/bin/aqt install-qt all_os wasm 6.8.3 wasm_singlethread -O /opt/qt \
       --archives qtbase qtsvg -m qtwebsockets

WORKDIR /src
COPY . .
ARG NW_HTTP_URL=https://noteworthy.olivermorrow.com
ARG NW_WS_URL=wss://noteworthy-ws.olivermorrow.com
RUN cmake -S . -B /build -G Ninja -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_TOOLCHAIN_FILE=/opt/qt/6.8.3/wasm_singlethread/lib/cmake/Qt6/qt.toolchain.cmake \
    -DQT_CHAINLOAD_TOOLCHAIN_FILE=/emsdk/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake \
    -DQT_HOST_PATH=/opt/qt/6.8.3/gcc_64 \
    -DNW_HTTP_URL="${NW_HTTP_URL}" -DNW_WS_URL="${NW_WS_URL}" \
    && cmake --build /build --parallel 2 \
    && install -d /site \
    && install -m 644 /build/noteworthy-qt.html /site/index.html \
    && install -m 644 /build/noteworthy-qt.js /build/noteworthy-qt.wasm /build/qtloader.js /build/qtlogo.svg /site/

FROM nginxinc/nginx-unprivileged:1.30.0-alpine@sha256:55465f646e63d7fb34be8cc17fdedbc89864f0f824d0d1906cdc5d81de093e12
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /site/ /usr/share/nginx/html/
EXPOSE 80
